[
  "/applications/{application_number}: operationId must be get_application_details",
  "/applications/{application_number}/withdraw: operationId must be withdraw_application",
  "/applications/{application_number}/notes: operationId must be add_application_note",
  "add_application_note: required body field note missing",
  "/applications/{application_number}/emails/log: operationId must be log_withdrawal_email",
  "log_withdrawal_email: required body field recipient_email missing",
  "log_withdrawal_email: required body field subject missing",
  "/applicants/{applicant_id}: operationId must be get_applicant_details"
]