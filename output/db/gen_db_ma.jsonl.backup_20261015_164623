{"scenario": "eBay", "task_id": "task_8", "task": "Create a saved search for 'wireless noise-cancelling headphones' with filters: condition is 'New', price range $150–$300, location within 50 miles of Chicago, and exclude auction listings — then set an email alert for new matches.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  username TEXT UNIQUE NOT NULL,\n  email TEXT UNIQUE NOT NULL,\n  full_name TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "saved_searches", "ddl": "CREATE TABLE saved_searches (\n  id INTEGER PRIMARY KEY,\n  user_id INTEGER NOT NULL,\n  name TEXT NOT NULL,\n  query TEXT NOT NULL,\n  condition TEXT CHECK (condition IN ('New', 'Used', 'Refurbished', 'For parts or not working')),\n  min_price REAL CHECK (min_price >= 0),\n  max_price REAL CHECK (max_price >= 0),\n  location_zip TEXT,\n  location_radius_miles INTEGER CHECK (location_radius_miles > 0),\n  exclude_auctions INTEGER NOT NULL DEFAULT 0 CHECK (exclude_auctions IN (0, 1)),\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,\n  CHECK (min_price IS NULL OR max_price IS NULL OR min_price <= max_price)\n);", "indexes": ["CREATE INDEX idx_saved_searches_user_id ON saved_searches(user_id);", "CREATE INDEX idx_saved_searches_created_at ON saved_searches(created_at);"]}, {"name": "email_alerts", "ddl": "CREATE TABLE email_alerts (\n  id INTEGER PRIMARY KEY,\n  saved_search_id INTEGER NOT NULL,\n  user_id INTEGER NOT NULL,\n  email TEXT NOT NULL,\n  frequency TEXT NOT NULL DEFAULT 'instant' CHECK (frequency IN ('instant', 'daily', 'weekly')),\n  is_active INTEGER NOT NULL DEFAULT 1 CHECK (is_active IN (0, 1)),\n  last_sent_at DATETIME,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (saved_search_id) REFERENCES saved_searches(id) ON DELETE CASCADE,\n  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE\n);", "indexes": ["CREATE INDEX idx_email_alerts_saved_search_id ON email_alerts(saved_search_id);", "CREATE INDEX idx_email_alerts_user_id ON email_alerts(user_id);", "CREATE INDEX idx_email_alerts_is_active ON email_alerts(is_active);"]}]}, "db_path": "output/db/databases/eBay_task_8.db"}
