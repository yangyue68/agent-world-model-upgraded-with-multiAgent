ethod_id);", "CREATE INDEX idx_payment_attempts_status ON payment_attempts(status);"]}, {"name": "dunning_events", "ddl": "CREATE TABLE dunning_events (id INTEGER PRIMARY KEY, invoice_id INTEGER NOT NULL REFERENCES invoices(id) ON DELETE CASCADE, subscription_id INTEGER NOT NULL REFERENCES subscriptions(id) ON DELETE CASCADE, email_number INTEGER NOT NULL CHECK (email_number > 0), recipient_email TEXT NOT NULL, payment_link TEXT, sent_at DATETIME DEFAULT CURRENT_TIMESTAMP, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_dunning_events_invoice_id ON dunning_events(invoice_id);", "CREATE INDEX idx_dunning_events_subscription_id ON dunning_events(subscription_id);", "CREATE INDEX idx_dunning_events_email_number ON dunning_events(email_number);"]}, {"name": "retry_schedules", "ddl": "CREATE TABLE retry_schedules (id INTEGER PRIMARY KEY, invoice_id INTEGER NOT NULL REFERENCES invoices(id) ON DELETE CASCADE, subscription_id INTEGER NOT NULL REFERENCES subscriptions(id) ON DELETE CASCADE, scheduled_at DATETIME NOT NULL, status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','completed','cancelled')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_retry_schedules_invoice_id ON retry_schedules(invoice_id);", "CREATE INDEX idx_retry_schedules_subscription_id ON retry_schedules(subscription_id);", "CREATE INDEX idx_retry_schedules_scheduled_at ON retry_schedules(scheduled_at);", "CREATE INDEX idx_retry_schedules_status ON retry_schedules(status);"]}, {"name": "subscription_suspensions", "ddl": "CREATE TABLE subscription_suspensions (id INTEGER PRIMARY KEY, subscription_id INTEGER NOT NULL REFERENCES subscriptions(id) ON DELETE CASCADE, reason TEXT, suspended_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP, suspended_until DATETIME NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEF