{"scenario": "Fidelity Investments", "task_id": "task_1", "task": "Open a new Fidelity Go account with $5,000 initial deposit, select 'Conservative' risk profile, and link it to the user's existing checking account ending in 7891.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, first_name TEXT NOT NULL, last_name TEXT NOT NULL, email TEXT UNIQUE NOT NULL, phone TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_email ON users(email);"]}, {"name": "checking_accounts", "ddl": "CREATE TABLE checking_accounts (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, account_number_last4 TEXT NOT NULL CHECK (length(account_number_last4) = 4), bank_name TEXT, routing_number TEXT, is_verified INTEGER DEFAULT 0 CHECK (is_verified IN (0,1)), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_checking_accounts_user_id ON checking_accounts(user_id);", "CREATE INDEX idx_checking_accounts_last4 ON checking_accounts(account_number_last4);"]}, {"name": "fidelity_go_accounts", "ddl": "CREATE TABLE fidelity_go_accounts (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, account_number TEXT UNIQUE NOT NULL, risk_profile TEXT NOT NULL CHECK (risk_profile IN ('Conservative', 'Moderate', 'Aggressive')), initial_deposit REAL NOT NULL CHECK (initial_deposit > 0), current_balance REAL NOT NULL DEFAULT 0, status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'closed', 'suspended')), linked_checking_account_id INTEGER, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE, FOREIGN KEY (linked_checking_account_id) REFERENCES checking_accounts(id) ON DELETE SET NULL);", "indexes": ["CREATE INDEX idx_fidelity_go_accounts_user_id ON fidelity_go_accounts(user_id);", "CREATE INDEX idx_fidelity_go_accounts_account_number ON fidelity_go_accounts(account_number);", "CREATE INDEX idx_fidelity_go_accounts_linked_checking ON fidelity_go_accounts(linked_checking_account_id);"]}, {"name": "transactions", "ddl": "CREATE TABLE transactions (id INTEGER PRIMARY KEY AUTOINCREMENT, account_id INTEGER NOT NULL, transaction_type TEXT NOT NULL CHECK (transaction_type IN ('deposit', 'withdrawal', 'transfer', 'fee', 'dividend', 'interest')), amount REAL NOT NULL, description TEXT, status TEXT NOT NULL DEFAULT 'completed' CHECK (status IN ('pending', 'completed', 'failed', 'cancelled')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (account_id) REFERENCES fidelity_go_accounts(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_transactions_account_id ON transactions(account_id);", "CREATE INDEX idx_transactions_created_at ON transactions(created_at);"]}]}, "db_path": "output/db/databases/Fidelity-Investments_task_1.db"}
