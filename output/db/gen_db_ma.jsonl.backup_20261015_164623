{"scenario": "Tiltify", "task_id": "task_15", "task": "Create an event campaign named \"Code for Clean Water Hackathon\" for \"Water Access Initiative\" with a $50,000 goal running from 2025-09-20 09:00 UTC through 2025-09-21 18:00 UTC, add milestones at $10,000, $25,000, and $50,000, and configure incentives for a sponsor match at $25,000 and a featured-project showcase at $50,000. Add a livestream integration for the campaign using Twitch channel \"codeforwaterlive\" with donation alerts enabled and an overlay displaying the donor name, message, amount, and campaign progress, then create a webhook subscription at \"https://hooks.example.org/tiltify/water-access\" for donation.created, donation.refunded, milestone.reached, and campaign.completed events with retry delivery enabled.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY,\n  username TEXT UNIQUE NOT NULL,\n  display_name TEXT,\n  email TEXT UNIQUE,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "organizations", "ddl": "CREATE TABLE organizations (\n  id INTEGER PRIMARY KEY,\n  name TEXT NOT NULL,\n  slug TEXT UNIQUE NOT NULL,\n  description TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_organizations_slug ON organizations(slug);"]}, {"name": "campaigns", "ddl": "CREATE TABLE campaigns (\n  id INTEGER PRIMARY KEY,\n  organization_id INTEGER NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,\n  created_by_user_id INTEGER NOT NULL REFERENCES users(id),\n  name TEXT NOT NULL,\n  slug TEXT UNIQUE NOT NULL,\n  description TEXT,\n  goal_amount REAL NOT NULL CHECK (goal_amount > 0),\n  currency TEXT NOT NULL DEFAULT 'USD',\n  starts_at DATETIME NOT NULL,\n  ends_at DATETIME NOT NULL,\n