AULT CURRENT_TIMESTAMP, FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE, FOREIGN KEY (source_account_id) REFERENCES accounts(id) ON DELETE RESTRICT, FOREIGN KEY (destination_account_id) REFERENCES accounts(id) ON DELETE RESTRICT);", "indexes": ["CREATE INDEX idx_rollovers_user_id ON rollovers(user_id);", "CREATE INDEX idx_rollovers_source_account_id ON rollovers(source_account_id);", "CREATE INDEX idx_rollovers_destination_account_id ON rollovers(destination_account_id);", "CREATE INDEX idx_rollovers_status ON rollovers(status);"]}, {"name": "portfolio_management_preferences", "ddl": "CREATE TABLE portfolio_management_preferences (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL, account_id INTEGER NOT NULL, rebalancing_frequency TEXT NOT NULL CHECK (rebalancing_frequency IN ('None', 'Monthly', 'Quarterly', 'Semi-Annually', 'Annually')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE, FOREIGN KEY (account_id) REFERENCES accounts(id) ON DELETE CASCADE, UNIQUE (account_id));", "indexes": ["CREATE INDEX idx_pmp_user_id ON portfolio_management_preferences(user_id);", "CREATE INDEX idx_pmp_account_id ON portfolio_management_preferences(account_id);"]}]}, "db_path": "output/db/databases/Fidelity-Investments_task_2.db"}
