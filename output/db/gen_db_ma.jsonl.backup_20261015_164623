{"scenario": "Jamf Pro", "task_id": "task_3", "task": "Search Jamf Pro MDM command logs from the past 30 days for failed or pending 'InstallApplication' and 'InstallProfile' commands on iPad and iPhone devices, group the results by app or profile name, and return the app/profile name, bundle ID or profile ID, failure/pending count, assigned username, and serial numbers of affected devices.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  username TEXT UNIQUE NOT NULL,\n  full_name TEXT,\n  email TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "devices", "ddl": "CREATE TABLE devices (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  serial_number TEXT UNIQUE NOT NULL,\n  device_name TEXT,\n  model TEXT NOT NULL CHECK (model IN ('iPad', 'iPhone')),\n  os_version TEXT,\n  assigned_user_id INTEGER,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (assigned_user_id) REFERENCES users(id) ON DELETE SET NULL\n);", "indexes": ["CREATE INDEX idx_devices_serial_number ON devices(serial_number);", "CREATE INDEX idx_devices_model ON devices(model);", "CREATE INDEX idx_devices_assigned_user_id ON devices(assigned_user_id);"]}, {"name": "apps", "ddl": "CREATE TABLE apps (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT NOT NULL,\n  bundle_id TEXT UNIQUE NOT NULL,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_apps_name ON apps(name);", "CREATE INDEX idx_apps_bundle_id ON apps(bundle_id);"]}, {"name": "profiles", "ddl": "CREATE TABLE profiles (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT NOT NULL,\n  profile_id TEXT UNIQUE NOT NULL,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_profiles_name ON profiles(name);", "CREATE INDEX idx_profiles_profile_id ON profiles(profile_id);"]}, {"name": "mdm_commands", "ddl": "CREATE TABLE mdm_commands (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  command_uuid TEXT UNIQUE NOT NULL,\n  command_type TEXT NOT NULL CHECK (command_type IN ('InstallApplication', 'InstallProfile')),\n  device_id INTEGER NOT NULL,\n  app_id INTEGER,\n  profile_id INTEGER,\n  status TEXT NOT NULL CHECK (status IN ('failed', 'pending', 'completed', 'acknowledged', 'error')),\n  error_message TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (device_id) REFERENCES devices(id) ON DELETE CASCADE,\n  FOREIGN KEY (app_id) REFERENCES apps(id) ON DELETE SET NULL,\n  FOREIGN KEY (profile_id) REFERENCES profiles(id) ON DELETE SET NULL,\n  CHECK (\n    (command_type = 'InstallApplication' AND app_id IS NOT NULL AND profile_id IS NULL)\n    OR\n    (command_type = 'InstallProfile' AND profile_id IS NOT NULL AND app_id IS NULL)\n  )\n);", "indexes": ["CREATE INDEX idx_mdm_commands_command_uuid ON mdm_commands(command_uuid);", "CREATE INDEX idx_mdm_commands_command_type ON mdm_commands(command_type);", "CREATE INDEX idx_mdm_commands_device_id ON mdm_commands(device_id);", "CREATE INDEX idx_mdm_commands_app_id ON mdm_commands(app_id);", "CREATE INDEX idx_mdm_commands_profile_id ON mdm_commands(profile_id);", "CREATE INDEX idx_mdm_commands_status ON mdm_commands(status);", "CREATE INDEX idx_mdm_commands_created_at ON mdm_commands(created_at);", "CREATE INDEX idx_mdm_commands_type_status_created ON mdm_commands(command_type, status, created_at);"]}]}, "db_path": "output/db/databases/Jamf-Pro_task_3.db"}
