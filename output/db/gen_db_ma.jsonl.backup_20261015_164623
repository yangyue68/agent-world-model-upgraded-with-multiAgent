ES job_titles(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_salary_reports_company_id ON salary_reports(company_id);", "CREATE INDEX idx_salary_reports_location_id ON salary_reports(location_id);", "CREATE INDEX idx_salary_reports_job_title_id ON salary_reports(job_title_id);", "CREATE INDEX idx_salary_reports_company_location_title ON salary_reports(company_id, location_id, job_title_id);"]}]}, "db_path": "output/db/databases/Indeed_task_10.db"}
