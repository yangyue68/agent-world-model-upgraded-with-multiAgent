 DEFAULT CURRENT_TIMESTAMP,\n  UNIQUE (client_id, log_date, meal_type)\n);", "indexes": ["CREATE INDEX idx_food_logs_client_date ON food_logs(client_id, log_date);", "CREATE INDEX idx_food_logs_meal_type ON food_logs(meal_type);"]}, {"name": "water_intake", "ddl": "CREATE TABLE water_intake (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  client_id INTEGER NOT NULL REFERENCES clients(id) ON DELETE CASCADE,\n  log_date DATE NOT NULL,\n  liters REAL NOT NULL CHECK (liters >= 0),\n  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  UNIQUE (client_id, log_date)\n);", "indexes": ["CREATE INDEX idx_water_intake_client_date ON water_intake(client_id, log_date);"]}, {"name": "practitioner_feedback", "ddl": "CREATE TABLE practitioner_feedback (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  client_id INTEGER NOT NULL REFERENCES clients(id) ON DELETE CASCADE,\n  practitioner_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,\n  feedback_date DATE NOT NULL,\n  feedback_text TEXT NOT NULL,\n  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_practitioner_feedback_client_date ON practitioner_feedback(client_id, feedback_date);", "CREATE INDEX idx_practitioner_feedback_practitioner ON practitioner_feedback(practitioner_id);"]}]}, "db_path": "output/db/databases/NutriCare_task_10.db"}
