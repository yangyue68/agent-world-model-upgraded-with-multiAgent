paign_incentives(type);"]}, {"name": "livestream_integrations", "ddl": "CREATE TABLE livestream_integrations (\n  id INTEGER PRIMARY KEY,\n  campaign_id INTEGER NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,\n  provider TEXT NOT NULL CHECK (provider IN ('twitch','youtube','facebook','custom')),\n  channel_name TEXT NOT NULL,\n  channel_url TEXT,\n  donation_alerts_enabled INTEGER NOT NULL DEFAULT 1 CHECK (donation_alerts_enabled IN (0,1)),\n  overlay_enabled INTEGER NOT NULL DEFAULT 1 CHECK (overlay_enabled IN (0,1)),\n  overlay_fields TEXT NOT NULL DEFAULT '[\"donor_name\",\"message\",\"amount\",\"campaign_progress\"]',\n  is_active INTEGER NOT NULL DEFAULT 1 CHECK (is_active IN (0,1)),\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  UNIQUE (campaign_id, provider, channel_name)\n);", "indexes": ["CREATE INDEX idx_livestream_integrations_campaign_id ON livestream_integrations(campaign_id);", "CREATE INDEX idx_livestream_integrations_provider ON livestream_integrations(provider);"]}, {"name": "webhook_subscriptions", "ddl": "CREATE TABLE webhook_subscriptions (\n  id INTEGER PRIMARY KEY,\n  campaign_id INTEGER NOT NULL REFERENCES campaigns(id) ON DELETE CASCADE,\n  url TEXT NOT NULL,\n  events TEXT NOT NULL,\n  retry_enabled INTEGER NOT NULL DEFAULT 1 CHECK (retry_enabled IN (0,1)),\n  is_active INTEGER NOT NULL DEFAULT 1 CHECK (is_active IN (0,1)),\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_webhook_subscriptions_campaign_id ON webhook_subscriptions(campaign_id);", "CREATE INDEX idx_webhook_subscriptions_url ON webhook_subscriptions(url);"]}]}, "db_path": "output/db/databases/Tiltify_task_15.db"}
