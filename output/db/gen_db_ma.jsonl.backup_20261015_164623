{"scenario": "FestivalOps", "task_id": "task_1", "task": "Search FestivalOps for the event 'Electric Bay 2025' and return a production overview: confirmed artist bookings, vendor booths with pending permits, unfilled staff and volunteer shifts, open security/medical incidents, overdue equipment check-outs, and current ticket attendance count.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT UNIQUE NOT NULL, display_name TEXT, email TEXT UNIQUE, phone TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "events", "ddl": "CREATE TABLE events (id INTEGER PRIMARY KEY, name TEXT NOT NULL, description TEXT, start_date DATETIME NOT NULL, end_date DATETIME NOT NULL, venue_name TEXT, venue_address TEXT, status TEXT NOT NULL DEFAULT 'planned' CHECK (status IN ('planned','active','completed','cancelled')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_events_name ON events(name);", "CREATE INDEX idx_events_status ON events(status);", "CREATE INDEX idx_events_dates ON events(start_date, end_date);"]}, {"name": "artists", "ddl": "CREATE TABLE artists (id INTEGER PRIMARY KEY, name TEXT NOT NULL, genre TEXT, contact_email TEXT, contact_phone TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_artists_name ON artists(name);"]}, {"name": "artist_bookings", "ddl": "CREATE TABLE artist_bookings (id INTEGER PRIMARY KEY, event_id INTEGER NOT NULL REFERENCES events(id) ON DELETE CASCADE, artist_id INTEGER NOT NULL REFERENCES artists(id) ON DELETE CASCADE, performance_date DATETIME, stage TEXT, fee REAL, status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','confirmed','cancelled')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(event_id, artist_id));", "indexes": ["CREATE INDEX idx_artist_bookings_event_id ON artist_bookings(event_id);", "CREATE INDEX idx_artist_bookings_artist_id ON artist_bookings(artist_id);", "CREATE INDEX idx_artist_bookings_status ON artist_bookings(status);"]}, {"name": "vendors", "ddl": "CREATE TABLE vendors (id INTEGER PRIMARY KEY, name TEXT NOT NULL, category TEXT, contact_name TEXT, contact_email TEXT, contact_phone TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_vendors_name ON vendors(name);", "CREATE INDEX idx_vendors_category ON vendors(category);"]}, {"name": "vendor_booths", "ddl": "CREATE TABLE vendor_booths (id INTEGER PRIMARY KEY, event_id INTEGER NOT NULL REFERENCES events(id) ON DELETE CASCADE, vendor_id INTEGER NOT NULL REFERENCES vendors(id) ON DELETE CASCADE, booth_number TEXT, location TEXT, permit_status TEXT NOT NULL DEFAULT 'pending' CHECK (permit_status IN ('pending','approved','rejected','expired')), permit_expiry_date DATETIME, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(event_id, vendor_id, booth_number));", "indexes": ["CREATE INDEX idx_vendor_booths_event_id ON vendor_booths(event_id);", "CREATE INDEX idx_vendor_booths_vendor_id ON vendor_booths(vendor_id);", "CREATE INDEX idx_vendor_booths_permit_status ON vendor_booths(permit_status);"]}, {"name": "staff_roles", "ddl": "CREATE TABLE staff_roles (id INTEGER PRIMARY KEY, role_name TEXT NOT NULL UNIQUE, description TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_staff_roles_role_name ON staff_roles(role_name);"]}, {"name": "staff_shifts", "ddl": "CREATE TABLE staff_shifts (id INTEGER PRIMARY KEY, event_id INTEGER NOT NULL REFERENCES events(id) ON DELETE CASCADE, role_id INTEGER NOT NULL REFERENCES staff_roles(id) ON DELETE CASCADE, shift_type TEXT NOT NULL DEFAULT 'staff' CHECK (shift_type IN ('staff','volunteer')), shift_start DATETIME NOT NULL, shift_end DATETIME NOT NULL, required_count INTEGER NOT NULL DEFAULT 1, assigned_user_id INTEGER REFERENCES users(id) ON DELETE SET NULL, status TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open','filled','cancelled')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_staff_shifts_event_id ON staff_shifts(event_id);", "CREATE INDEX idx_staff_shifts_role_id ON staff_shifts(role_id);", "CREATE INDEX idx_staff_shifts_shift_type ON staff_shifts(shift_type);", "CREATE INDEX idx_staff_shifts_status ON staff_shifts(status);", "CREATE INDEX idx_staff_shifts_assigned_user_id ON staff_shifts(assigned_user_id);"]}, {"name": "incidents", "ddl": "CREATE TABLE incidents (id INTEGER PRIMARY KEY, event_id INTEGER NOT NULL REFERENCES events(id) ON DELETE CASCADE, incident_type TEXT NOT NULL CHECK (incident_type IN ('security','medical','other')), description TEXT NOT NULL, location TEXT, reported_by_user_id INTEGER REFERENCES users(id) ON DELETE SET NULL, reported_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP, resolved_at DATETIME, status TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open','resolved','closed')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_incidents_event_id ON incidents(event_id);", "CREATE INDEX idx_incidents_type ON incidents(incident_type);", "CREATE INDEX idx_incidents_status ON incidents(status);", "CREATE INDEX idx_incidents_reported_at ON incidents(reported_at);"]}, {"name": "equipment", "ddl": "CREATE TABLE equipment (id INTEGER PRIMARY KEY, name TEXT NOT NULL, description TEXT, serial_number TEXT UNIQUE, category TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);