s", "ddl": "CREATE TABLE return_reasons (id INTEGER PRIMARY KEY, reason_code TEXT UNIQUE NOT NULL, description TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_return_reasons_reason_code ON return_reasons(reason_code);"]}, {"name": "return_requests", "ddl": "CREATE TABLE return_requests (id INTEGER PRIMARY KEY, order_id INTEGER NOT NULL, order_item_id INTEGER NOT NULL, user_id INTEGER NOT NULL, return_reason_id INTEGER NOT NULL, refund_type TEXT NOT NULL CHECK (refund_type IN ('full','partial','replacement','exchange')), refund_amount REAL CHECK (refund_amount >= 0), prepaid_return_shipping INTEGER NOT NULL DEFAULT 0 CHECK (prepaid_return_shipping IN (0,1)), status TEXT NOT NULL DEFAULT 'initiated' CHECK (status IN ('initiated','approved','rejected','shipped','received','refunded','cancelled')), comments TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE, FOREIGN KEY (order_item_id) REFERENCES order_items(id) ON DELETE CASCADE, FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE, FOREIGN KEY (return_reason_id) REFERENCES return_reasons(id));", "indexes": ["CREATE INDEX idx_return_requests_order_id ON return_requests(order_id);", "CREATE INDEX idx_return_requests_order_item_id ON return_requests(order_item_id);", "CREATE INDEX idx_return_requests_user_id ON return_requests(user_id);", "CREATE INDEX idx_return_requests_return_reason_id ON return_requests(return_reason_id);", "CREATE INDEX idx_return_requests_status ON return_requests(status);"]}]}, "db_path": "output/db/databases/eBay_task_10.db"}
