{"scenario": "Indeed", "task_id": "task_9", "task": "On Indeed, research Microsoft's company page for the Redmond, WA location: retrieve the overall rating, CEO approval percentage, recommend-to-a-friend percentage, the average base salary for a Software Engineer, and the five most recent Software Engineer employee reviews. Summarize the recurring pros and cons mentioned in those reviews.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, username TEXT UNIQUE NOT NULL, email TEXT UNIQUE, full_name TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "companies", "ddl": "CREATE TABLE companies (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, description TEXT, website TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_companies_name ON companies(name);"]}, {"name": "locations", "ddl": "CREATE TABLE locations (id INTEGER PRIMARY KEY AUTOINCREMENT, city TEXT NOT NULL, state TEXT, country TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(city, state, country));", "indexes": ["CREATE INDEX idx_locations_city_state ON locations(city, state);"]}, {"name": "company_locations", "ddl": "CREATE TABLE company_locations (id INTEGER PRIMARY KEY AUTOINCREMENT, company_id INTEGER NOT NULL, location_id INTEGER NOT NULL, overall_rating REAL CHECK(overall_rating >= 0 AND overall_rating <= 5), ceo_approval_percentage REAL CHECK(ceo_approval_percentage >= 0 AND ceo_approval_percentage <= 100), recommend_to_friend_percentage REAL CHECK(recommend_to_friend_percentage >= 0 AND recommend_to_friend_percentage <= 100), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMES