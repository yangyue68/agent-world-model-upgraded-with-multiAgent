_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_notification_rules_alert_rule_id ON notification_rules(alert_rule_id);", "CREATE INDEX idx_notification_rules_recipient_email ON notification_rules(recipient_email);"]}, {"name": "incidents", "ddl": "CREATE TABLE incidents (id INTEGER PRIMARY KEY, site_id INTEGER NOT NULL REFERENCES sites(id) ON DELETE CASCADE, alert_rule_id INTEGER REFERENCES alert_rules(id) ON DELETE SET NULL, title TEXT NOT NULL, description TEXT, priority TEXT NOT NULL CHECK(priority IN ('low','medium','high','critical')), status TEXT NOT NULL DEFAULT 'open' CHECK(status IN ('open','acknowledged','resolved','closed')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_incidents_site_id ON incidents(site_id);", "CREATE INDEX idx_incidents_alert_rule_id ON incidents(alert_rule_id);", "CREATE INDEX idx_incidents_priority ON incidents(priority);", "CREATE INDEX idx_incidents_status ON incidents(status);"]}, {"name": "subscriptions", "ddl": "CREATE TABLE subscriptions (id INTEGER PRIMARY KEY, alert_rule_id INTEGER NOT NULL REFERENCES alert_rules(id) ON DELETE CASCADE, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, subscription_type TEXT NOT NULL CHECK(subscription_type IN ('daily_summary')), is_active INTEGER NOT NULL DEFAULT 1 CHECK(is_active IN (0,1)), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(alert_rule_id, user_id, subscription_type));", "indexes": ["CREATE INDEX idx_subscriptions_alert_rule_id ON subscriptions(alert_rule_id);", "CREATE INDEX idx_subscriptions_user_id ON subscriptions(user_id);"]}]}, "db_path": "output/db/databases/HelioTrack_task_4.db"}
