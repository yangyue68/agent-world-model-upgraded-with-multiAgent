licitations(id) ON DELETE CASCADE,\n  FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE SET NULL,\n  FOREIGN KEY (asked_by) REFERENCES users(id) ON DELETE SET NULL\n);", "indexes": ["CREATE INDEX idx_clarification_questions_solicitation_id ON clarification_questions(solicitation_id);", "CREATE INDEX idx_clarification_questions_supplier_id ON clarification_questions(supplier_id);", "CREATE INDEX idx_clarification_questions_status ON clarification_questions(status);", "CREATE INDEX idx_clarification_questions_asked_at ON clarification_questions(asked_at);"]}, {"name": "clarification_responses", "ddl": "CREATE TABLE clarification_responses (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  question_id INTEGER NOT NULL UNIQUE,\n  response_text TEXT NOT NULL,\n  responded_by INTEGER NOT NULL,\n  responded_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (question_id) REFERENCES clarification_questions(id) ON DELETE CASCADE,\n  FOREIGN KEY (responded_by) REFERENCES users(id) ON DELETE RESTRICT\n);", "indexes": ["CREATE INDEX idx_clarification_responses_question_id ON clarification_responses(question_id);", "CREATE INDEX idx_clarification_responses_responded_by ON clarification_responses(responded_by);", "CREATE INDEX idx_clarification_responses_responded_at ON clarification_responses(responded_at);"]}, {"name": "compliance_documents", "ddl": "CREATE TABLE compliance_documents (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  supplier_id INTEGER NOT NULL,\n  document_type TEXT NOT NULL,\n  document_number TEXT,\n  issue_date DATETIME,\n  expiry_date DATETIME,\n  file_path TEXT,\n  status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending','valid','expired','missing','rejected')),\n  verified_by INTEGER,\n  verified_at DATETIME,\n  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE CASCADE,\n  FOREIGN KEY (verified_by) REFERENCES users(id) ON DELETE SET NULL\n);", "indexes": ["CREATE INDEX idx_compliance_documents_supplier_id ON compliance_documents(supplier_id);", "CREATE INDEX idx_compliance_documents_document_type ON compliance_documents(document_type);", "CREATE INDEX idx_compliance_documents_expiry_date ON compliance_documents(expiry_date);", "CREATE INDEX idx_compliance_documents_status ON compliance_documents(status);", "CREATE INDEX idx_compliance_documents_verified_by ON compliance_documents(verified_by);"]}, {"name": "bids", "ddl": "CREATE TABLE bids (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  solicitation_id INTEGER NOT NULL,\n  supplier_id INTEGER NOT NULL,\n  bid_reference TEXT UNIQUE,\n  submission_time DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  sealed_status TEXT NOT NULL DEFAULT 'sealed' CHECK (sealed_status IN ('sealed','opened','withdrawn','disqualified')),\n  opened_at DATETIME,\n  opened_by INTEGER,\n  total_amount REAL,\n  currency TEXT DEFAULT 'USD',\n  notes TEXT,\n  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (solicitation_id) REFERENCES solicitations(id) ON DELETE CASCADE,\n  FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE CASCADE,\n  FOREIGN KEY (opened_by) REFERENCES users(id) ON DELETE SET NULL,\n  UNIQUE (solicitation_id, supplier_id)\n);", "indexes": ["CREATE INDEX idx_bids_solicitation_id ON bids(solicitation_id);", "CREATE INDEX idx_bids_supplier_id ON bids(supplier_id);", "CREATE INDEX idx_bids_submission_time ON bids(submission_time);", "CREATE INDEX idx_bids_sealed_status ON bids(sealed_status);", "CREATE INDEX idx_bids_opened_by ON bids(opened_by);"]}]}, "db_path": "output/db/databases/SealProcure_task_2.db"}
{"scenario": "SealProcure", "task_id": "task_3", "task": "Query the award, contract, and vendor performance APIs to find vendors with active contracts expiring within the next 90 days, total awarded amount over $2,000,000 in FY2024, at least one open protest, and an average evaluation score below 85; return vendor name, UEI, contract number, expiration date, awarded amount, protest status, and performance rating, sorted by expiration date ascending.", "db_schema": {"tables": [{"name": "vendors", "ddl": "CREATE TABLE vendors (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT NOT NULL,\n  uei TEXT UNIQUE NOT NULL,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_vendors_name ON vendors(name);", "CREATE INDEX idx_vendors_uei ON vendors(uei);"]}, {"name": "contracts", "ddl": "CREATE TABLE contracts (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  vendor_id INTEGER NOT NULL,\n  contract_number TEXT UNIQUE NOT NULL,\n  awarded_amount REAL NOT NULL CHECK (awarded_amount >= 0),\n  expiration_date DATE NOT NULL,\n  status TEXT NOT NULL CHECK (status IN ('active', 'expired', 'terminated', 'pending')),\n  fiscal_year INTEGER NOT NULL,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (vendor_id) REFERENCES vendors(id) ON DELETE CASCADE\n);", "indexes": ["CREATE INDEX idx_contracts_vendor_id ON contracts(vendor_id);", "CREATE INDEX idx_contracts_expiration_date ON contracts(expiration_date);", "CREATE INDEX idx_contracts_status ON contracts(status);", "CREATE INDEX idx_contracts_fiscal_year ON contracts(fiscal_year);", "CREATE INDEX idx_contracts_vendor_status_exp ON contracts(vendor_id, status, expiration_date);"]}, {"name": "protests", "ddl": "CREATE TABLE protests (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  vendor_id INTEGER NOT NULL,\n  contract_id INTEGER,\n  status TEXT NOT NULL CHECK (status IN ('open', 'closed', 'withdrawn', 'denied')),\n  filed_date DATE NOT NULL,\n  resolved_date DATE,\n  description TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (vendor_id) REFERENCES vendors(id) ON DELETE CASCADE,\n  FOREIGN KEY (contract_id) REFERENCES contracts(id) ON DELETE SET NULL\n);", "indexes": ["CREATE INDEX idx_protests_vendor_id ON protests(vendor_id);", "CREATE INDEX idx_protests_status ON protests(status);", "CREATE INDEX idx_protests_vendor_status ON protests(vendor_id, status);"]}, {"name": "performance_evaluations", "ddl": "CREATE TABLE performance_evaluations (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  vendor_id INTEGER NOT NULL,\n  contract_id INTEGER,\n  evaluation_date DATE NOT NULL,\n  score REAL NOT NULL CHECK (score >= 0 AND score <= 100),\n  rating TEXT CHECK (rating IN ('excellent', 'good', 'satisfactory', 'marginal', 'poor')),\n  comments TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (vendor_id) REFERENCES vendors(id) ON DELETE CASCADE,\n  FOREIGN KEY (contract_id) REFERENCES contracts(id) ON DELETE SET NULL\n);", "indexes": ["CREATE INDEX idx_perf_eval_vendor_id ON performance_evaluations(vendor_id);", "CREATE INDEX idx_perf_eval_contract_id ON performance_evaluations(contract_id);", "CREATE INDEX idx_perf_eval_score ON performance_evaluations(score);", "CREATE INDEX idx_perf_eval_vendor_score ON performance_evaluations(vendor_id, score);"]}]}, "db_path": "output/db/databases/SealProcure_task_3.db"}
