 "CREATE INDEX idx_customers_name ON customers(last_name, first_name);"]}, {"name": "vehicles", "ddl": "CREATE TABLE vehicles (id INTEGER PRIMARY KEY AUTOINCREMENT, vin TEXT UNIQUE, make TEXT NOT NULL, model TEXT NOT NULL, trim TEXT, model_year INTEGER NOT NULL CHECK (model_year >= 1900), body_style TEXT, exterior_color TEXT, interior_color TEXT, mileage INTEGER CHECK (mileage >= 0), price REAL CHECK (price >= 0), location_id INTEGER REFERENCES locations(id) ON DELETE SET NULL, stock_number TEXT, status TEXT NOT NULL DEFAULT 'available' CHECK (status IN ('available','pending','sold','in_transit','wholesale')), created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_vehicles_make_model ON vehicles(make, model);", "CREATE INDEX idx_vehicles_year ON vehicles(model_year);", "CREATE INDEX idx_vehicles_location ON vehicles(location_id);", "CREATE INDEX idx_vehicles_status ON vehicles(status);", "CREATE INDEX idx_vehicles_vin ON vehicles(vin);"]}, {"name": "leads", "ddl": "CREATE TABLE leads (id INTEGER PRIMARY KEY AUTOINCREMENT, customer_id INTEGER NOT NULL REFERENCES customers(id) ON DELETE CASCADE, vehicle_id INTEGER REFERENCES vehicles(id) ON DELETE SET NULL, location_id INTEGER REFERENCES locations(id) ON DELETE SET NULL, assigned_to_user_id INTEGER REFERENCES users(id) ON DELETE SET NULL, source TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'New' CHECK (status IN ('New','Contacted','Qualified','Appointment Set','Negotiating','Sold','Lost')), notes TEXT, created_by_user_id INTEGER REFERENCES users(id) ON DELETE SET NULL, created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_leads_customer ON leads(customer_id);", "CREATE INDEX idx_leads_vehicle ON leads(vehicle_id);", "CREATE INDEX idx_leads_location ON leads(location_id);", "CREATE INDEX idx_leads_assigned_to ON leads(assigned_to_user_id);", 