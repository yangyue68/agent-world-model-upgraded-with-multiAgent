"name": "portfolio_options", "ddl": "CREATE TABLE portfolio_options (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  plan_type TEXT NOT NULL,\n  name TEXT NOT NULL,\n  description TEXT,\n  risk_level TEXT CHECK (risk_level IN ('conservative', 'moderate', 'aggressive')),\n  is_age_based INTEGER NOT NULL DEFAULT 0 CHECK (is_age_based IN (0, 1)),\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  UNIQUE (plan_type, name)\n);", "indexes": ["CREATE INDEX idx_portfolio_options_plan_type ON portfolio_options(plan_type);"]}, {"name": "college_savings_plans", "ddl": "CREATE TABLE college_savings_plans (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  user_id INTEGER NOT NULL,\n  beneficiary_id INTEGER NOT NULL,\n  plan_name TEXT NOT NULL,\n  plan_type TEXT NOT NULL DEFAULT '529',\n  portfolio_option_id INTEGER NOT NULL,\n  account_number TEXT UNIQUE,\n  status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'closed', 'pending')),\n  opened_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,\n  FOREIGN KEY (beneficiary_id) REFERENCES beneficiaries(id) ON DELETE RESTRICT,\n  FOREIGN KEY (portfolio_option_id) REFERENCES portfolio_options(id) ON DELETE RESTRICT\n);", "indexes": ["CREATE INDEX idx_college_savings_plans_user_id ON college_savings_plans(user_id);", "CREATE INDEX idx_college_savings_plans_beneficiary_id ON college_savings_plans(beneficiary_id);", "CREATE INDEX idx_college_savings_plans_portfolio_option_id ON college_savings_plans(portfolio_option_id);", "CREATE INDEX idx_college_savings_plans_status ON college_savings_plans(status);"]}, {"name": "automatic_contributions", "ddl": "CREATE TABLE automatic_contributions (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  plan_id INTEGER NOT NULL,\n  bank_account_id INTEGER NOT NULL,\n  amount REAL NOT NULL CHECK (amount > 0),\n  frequency TEXT NOT NULL CHECK (frequency IN ('weekly', 'biweekly', 'monthly', 'quarterly', 'annually')),\n  start_date TEXT NOT NULL,\n  end_date TEXT,\n  next_contribution_date TEXT,\n  status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'paused', 'cancelled')),\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (plan_id) REFERENCES college_savings_plans(id) ON DELETE CASCADE,\n  FOREIGN KEY (bank_account_id) REFERENCES bank_accounts(id) ON DELETE RESTRICT\n);", "indexes": ["CREATE INDEX idx_automatic_contributions_plan_id ON automatic_contributions(plan_id);", "CREATE INDEX idx_automatic_contributions_bank_account_id ON automatic_contributions(bank_account_id);", "CREATE INDEX idx_automatic_contributions_status ON automatic_contributions(status);"]}]}, "db_path": "output/db/databases/Fidelity-Investments_task_3.db"}
