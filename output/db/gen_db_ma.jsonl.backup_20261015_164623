ETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE (ifb_id, line_number));", "indexes": ["CREATE INDEX idx_ifb_line_items_ifb_id ON ifb_line_items(ifb_id);"]}, {"name": "ifb_specifications", "ddl": "CREATE TABLE ifb_specifications (id INTEGER PRIMARY KEY AUTOINCREMENT, ifb_id INTEGER NOT NULL REFERENCES ifbs(id) ON DELETE CASCADE, category TEXT NOT NULL CHECK (category IN ('material','installation','general')), specification TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_ifb_specifications_ifb_id ON ifb_specifications(ifb_id);", "CREATE INDEX idx_ifb_specifications_category ON ifb_specifications(category);"]}, {"name": "evaluation_criteria", "ddl": "CREATE TABLE evaluation_criteria (id INTEGER PRIMARY KEY AUTOINCREMENT, ifb_id INTEGER NOT NULL REFERENCES ifbs(id) ON DELETE CASCADE, criterion TEXT NOT NULL, weight_percent REAL NOT NULL CHECK (weight_percent >= 0 AND weight_percent <= 100), description TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE (ifb_id, criterion));", "indexes": ["CREATE INDEX idx_evaluation_criteria_ifb_id ON evaluation_criteria(ifb_id);"]}, {"name": "required_documents", "ddl": "CREATE TABLE required_documents (id INTEGER PRIMARY KEY AUTOINCREMENT, ifb_id INTEGER NOT NULL REFERENCES ifbs(id) ON DELETE CASCADE, document_name TEXT NOT NULL, description TEXT, is_mandatory INTEGER NOT NULL DEFAULT 1 CHECK (is_mandatory IN (0,1)), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE (ifb_id, document_name));", "indexes": ["CREATE INDEX idx_required_documents_ifb_id ON required_documents(ifb_id);"]}]}, "db_path": "output/db/databases/SealProcure_task_5.db"}
