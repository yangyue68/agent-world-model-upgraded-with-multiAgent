XT NOT NULL, destination_country_id INTEGER NOT NULL, min_days INTEGER NOT NULL CHECK (min_days >= 0), max_days INTEGER NOT NULL CHECK (max_days >= min_days), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (service_type_id) REFERENCES service_types(id) ON DELETE CASCADE, FOREIGN KEY (destination_country_id) REFERENCES countries(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_transit_times_service ON transit_times(service_type_id);", "CREATE INDEX idx_transit_times_origin_zip ON transit_times(origin_zip);", "CREATE INDEX idx_transit_times_destination_country ON transit_times(destination_country_id);"]}, {"name": "duty_tax_rates", "ddl": "CREATE TABLE duty_tax_rates (id INTEGER PRIMARY KEY, destination_country_id INTEGER NOT NULL, min_value REAL NOT NULL DEFAULT 0 CHECK (min_value >= 0), max_value REAL CHECK (max_value IS NULL OR max_value >= min_value), duty_rate REAL NOT NULL DEFAULT 0 CHECK (duty_rate >= 0), tax_rate REAL NOT NULL DEFAULT 0 CHECK (tax_rate >= 0), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (destination_country_id) REFERENCES countries(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_duty_tax_rates_country ON duty_tax_rates(destination_country_id);", "CREATE INDEX idx_duty_tax_rates_value_range ON duty_tax_rates(min_value, max_value);"]}, {"name": "rate_queries", "ddl": "CREATE TABLE rate_queries (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL, origin_zip TEXT NOT NULL, destination_postal_code TEXT NOT NULL, destination_country_id INTEGER NOT NULL, weight_kg REAL NOT NULL CHECK (weight_kg > 0), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE, FOREIGN KEY (destination_country_id) REFERENCES countries(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_rate_queries_user ON rate_queries(user_id);", "CREATE INDEX idx_rate_queries_origin_zip ON rate_queries(origin_zip);", "CREATE INDEX idx_rate_queries_destination ON rate_queries(destination_postal_code, destination_country_id);"]}, {"name": "rate_query_results", "ddl": "CREATE TABLE rate_query_results (id INTEGER PRIMARY KEY, rate_query_id INTEGER NOT NULL, service_type_id INTEGER NOT NULL, shipping_rate REAL NOT NULL CHECK (shipping_rate >= 0), transit_min_days INTEGER NOT NULL CHECK (transit_min_days >= 0), transit_max_days INTEGER NOT NULL CHECK (transit_max_days >= transit_min_days), estimated_duty REAL NOT NULL DEFAULT 0 CHECK (estimated_duty >= 0), estimated_tax REAL NOT NULL DEFAULT 0 CHECK (estimated_tax >= 0), total_cost REAL NOT NULL CHECK (total_cost >= 0), currency TEXT NOT NULL DEFAULT 'USD', created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (rate_query_id) REFERENCES rate_queries(id) ON DELETE CASCADE, FOREIGN KEY (service_type_id) REFERENCES service_types(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_rate_query_results_query ON rate_query_results(rate_query_id);", "CREATE INDEX idx_rate_query_results_service ON rate_query_results(service_type_id);"]}]}, "db_path": "output/db/databases/FedEx_task_9.db"}
