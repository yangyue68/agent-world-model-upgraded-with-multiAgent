CK (status IN ('available', 'empty', 'in_use', 'maintenance', 'cleaning')), cellar_id INTEGER, barrel_room_id INTEGER, temperature_controlled INTEGER NOT NULL DEFAULT 0 CHECK (temperature_controlled IN (0, 1)), cooperage_id INTEGER, toast_level TEXT CHECK (toast_level IN ('light', 'medium', 'medium_plus', 'heavy')), vintage INTEGER CHECK (vintage >= 1900 AND vintage <= 2100), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (cellar_id) REFERENCES cellars(id) ON DELETE SET NULL, FOREIGN KEY (barrel_room_id) REFERENCES barrel_rooms(id) ON DELETE SET NULL, FOREIGN KEY (cooperage_id) REFERENCES cooperages(id) ON DELETE SET NULL, CHECK ((vessel_type = 'tank' AND cellar_id IS NOT NULL AND barrel_room_id IS NULL AND cooperage_id IS NULL AND toast_level IS NULL AND vintage IS NULL) OR (vessel_type = 'barrel' AND barrel_room_id IS NOT NULL AND cellar_id IS NULL AND cooperage_id IS NOT NULL AND toast_level IS NOT NULL AND vintage IS NOT NULL)));", "indexes": ["CREATE INDEX idx_vessels_name ON vessels(name);", "CREATE INDEX idx_vessels_vessel_type ON vessels(vessel_type);", "CREATE INDEX idx_vessels_status ON vessels(status);", "CREATE INDEX idx_vessels_cellar_id ON vessels(cellar_id);", "CREATE INDEX idx_vessels_barrel_room_id ON vessels(barrel_room_id);", "CREATE INDEX idx_vessels_cooperage_id ON vessels(cooperage_id);"]}]}, "db_path": "output/db/databases/VineTrack_task_2.db"}
{"scenario": "VineTrack", "task_id": "task_3", "task": "Configure packaging inventory master data in VineTrack for a new wine: create a 750 mL Bordeaux-style glass bottle SKU 'BOR-750-CLR' with natural cork closure and 12 bottles per case, create a front label named 'Estate Cabernet Sauvignon 2022' with vintage 2022, varietal Cabernet Sauvignon, appellation Napa Valley, alcohol 14.2% ABV, and TTB COLA approval number '22001ABC', then assign that label to the bottle SKU and set the case pack to 12 x 750 mL with active status.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  username TEXT NOT NULL UNIQUE,\n  full_name TEXT,\n  email TEXT UNIQUE,\n  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "bottle_skus", "ddl": "CREATE TABLE bottle_skus (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  sku_code TEXT NOT NULL UNIQUE,\n  description TEXT,\n  bottle_volume_ml REAL NOT NULL CHECK (bottle_volume_ml > 0),\n  bottle_style TEXT,\n  glass_color TEXT,\n  closure_type TEXT NOT NULL CHECK (closure_type IN ('natural_cork','synthetic_cork','screw_cap','crown_cap','other')),\n  bottles_per_case INTEGER NOT NULL CHECK (bottles_per_case > 0),\n  status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active','inactive')),\n  created_by INTEGER NOT NULL REFERENCES users(id),\n  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_bottle_skus_sku_code ON bottle_skus(sku_code);", "CREATE INDEX idx_bottle_skus_status ON bottle_skus(status);", "CREATE INDEX idx_bottle_skus_created_by ON bottle_skus(created_by);"]}, {"name": "labels", "ddl": "CREATE TABLE labels (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  label_name TEXT NOT NU