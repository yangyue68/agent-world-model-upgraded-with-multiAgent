, 'failed')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_audit_runs_run_by_user_id ON audit_runs(run_by_user_id);", "CREATE INDEX idx_audit_runs_period ON audit_runs(period_start, period_end);"]}, {"name": "audit_findings", "ddl": "CREATE TABLE audit_findings (id INTEGER PRIMARY KEY, audit_run_id INTEGER NOT NULL REFERENCES audit_runs(id), case_id INTEGER NOT NULL REFERENCES cases(id), material_id INTEGER NOT NULL REFERENCES materials(id), recorded_quantity REAL NOT NULL, expected_quantity REAL NOT NULL, variance_percent REAL NOT NULL, exceeds_threshold INTEGER NOT NULL CHECK (exceeds_threshold IN (0, 1)), verified INTEGER NOT NULL DEFAULT 0 CHECK (verified IN (0, 1)), adjustment_quantity REAL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_audit_findings_audit_run_id ON audit_findings(audit_run_id);", "CREATE INDEX idx_audit_findings_case_id ON audit_findings(case_id);", "CREATE INDEX idx_audit_findings_material_id ON audit_findings(material_id);", "CREATE INDEX idx_audit_findings_exceeds_threshold ON audit_findings(exceeds_threshold);"]}, {"name": "inventory_adjustments", "ddl": "CREATE TABLE inventory_adjustments (id INTEGER PRIMARY KEY, inventory_id INTEGER NOT NULL REFERENCES inventory(id), audit_finding_id INTEGER REFERENCES audit_findings(id), adjustment_quantity REAL NOT NULL, reason TEXT, adjusted_by_user_id INTEGER NOT NULL REFERENCES users(id), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_inventory_adjustments_inventory_id ON inventory_adjustments(inventory_id);", "CREATE INDEX idx_inventory_adjustments_audit_finding_id ON inventory_adjustments(audit_finding_id);", "CREATE INDEX idx_inventory_adjustments_adjusted_by_user_id ON inventory_adjustments(adjusted_by_user_id);"]}]}, "db_path": "output/db/databases/CrownLab_task_9.db"}
