code);"]}, {"name": "specimens", "ddl": "CREATE TABLE specimens (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  specimen_code TEXT UNIQUE NOT NULL,\n  donor_id INTEGER NOT NULL,\n  protocol_id INTEGER NOT NULL,\n  rack_id INTEGER NOT NULL,\n  tissue_type TEXT NOT NULL,\n  collection_date DATE NOT NULL,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (donor_id) REFERENCES donors(id) ON DELETE RESTRICT,\n  FOREIGN KEY (protocol_id) REFERENCES protocols(id) ON DELETE RESTRICT,\n  FOREIGN KEY (rack_id) REFERENCES racks(id) ON DELETE RESTRICT\n);", "indexes": ["CREATE INDEX idx_specimens_donor_id ON specimens(donor_id);", "CREATE INDEX idx_specimens_protocol_id ON specimens(protocol_id);", "CREATE INDEX idx_specimens_rack_id ON specimens(rack_id);", "CREATE INDEX idx_specimens_tissue_type ON specimens(tissue_type);", "CREATE INDEX idx_specimens_collection_date ON specimens(collection_date);", "CREATE INDEX idx_specimens_donor_protocol ON specimens(donor_id, protocol_id);"]}, {"name": "viability_tests", "ddl": "CREATE TABLE viability_tests (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  specimen_id INTEGER NOT NULL,\n  test_date DATETIME NOT NULL,\n  result_percent REAL NOT NULL CHECK (result_percent >= 0.0 AND result_percent <= 100.0),\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (specimen_id) REFERENCES specimens(id) ON DELETE CASCADE\n);", "indexes": ["CREATE INDEX idx_viability_tests_specimen_id ON viability_tests(specimen_id);", "CREATE INDEX idx_viability_tests_test_date ON viability_tests(test_date);", "CREATE INDEX idx_viability_tests_result_percent ON viability_tests(result_percent);", "CREATE INDEX idx_viability_tests_specimen_result ON viability_tests(specimen_id, result_percent);"]}]}, "db_path": "output/db/databases/BioVault-Cryo-Repository_task_3.db"}
