{"scenario": "PayPal", "task_id": "task_6", "task": "Convert $250.00 USD from your primary PayPal balance to EUR at the current exchange rate and deposit the converted amount into your linked EUR balance.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  username TEXT UNIQUE NOT NULL,\n  email TEXT UNIQUE NOT NULL,\n  full_name TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "currencies", "ddl": "CREATE TABLE currencies (\n  code TEXT PRIMARY KEY,\n  name TEXT NOT NULL,\n  symbol TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": []}, {"name": "exchange_rates", "ddl": "CREATE TABLE exchange_rates (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  base_currency_code TEXT NOT NULL,\n  quote_currency_code TEXT NOT NULL,\n  rate REAL NOT NULL CHECK (rate > 0),\n  effective_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (base_currency_code) REFERENCES currencies(code),\n  FOREIGN KEY (quote_currency_code) REFERENCES currencies(code),\n  UNIQUE (base_currency_code, quote_currency_code, effective_at)\n);", "indexes": ["CREATE INDEX idx_exchange_rates_pair ON exchange_rates(base_currency_code, quote_currency_code);", "CREATE INDEX idx_exchange_rates_effective_at ON exchange_rates(effective_at);"]}, {"name": "balances", "ddl": "CREATE TABLE balances (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  user_id INTEGER NOT NULL,\n  currency_code TEXT NOT NULL,\n  amount REAL NOT NULL DEFAULT 0 CHECK (amount >= 0),\n  is_primary INTEGER NOT NULL DEFAULT 0 CHECK (is_primary IN (0,1)),\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETI