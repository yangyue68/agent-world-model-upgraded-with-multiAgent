ation_id);"]}, {"name": "locations", "ddl": "CREATE TABLE locations (id INTEGER PRIMARY KEY, name TEXT NOT NULL, address TEXT, latitude REAL, longitude REAL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_locations_name ON locations(name);"]}, {"name": "shifts", "ddl": "CREATE TABLE shifts (id INTEGER PRIMARY KEY, food_truck_id INTEGER NOT NULL REFERENCES food_trucks(id) ON DELETE CASCADE, shift_date DATE NOT NULL, location_id INTEGER REFERENCES locations(id) ON DELETE SET NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(food_truck_id, shift_date));", "indexes": ["CREATE INDEX idx_shifts_food_truck_id ON shifts(food_truck_id);", "CREATE INDEX idx_shifts_shift_date ON shifts(shift_date);", "CREATE INDEX idx_shifts_location_id ON shifts(location_id);"]}, {"name": "shift_assignments", "ddl": "CREATE TABLE shift_assignments (id INTEGER PRIMARY KEY, shift_id INTEGER NOT NULL REFERENCES shifts(id) ON DELETE CASCADE, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, role TEXT NOT NULL, start_time TEXT NOT NULL, end_time TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(shift_id, user_id, role));", "indexes": ["CREATE INDEX idx_shift_assignments_shift_id ON shift_assignments(shift_id);", "CREATE INDEX idx_shift_assignments_user_id ON shift_assignments(user_id);"]}, {"name": "routes", "ddl": "CREATE TABLE routes (id INTEGER PRIMARY KEY, shift_id INTEGER NOT NULL REFERENCES shifts(id) ON DELETE CASCADE, origin_location_id INTEGER NOT NULL REFERENCES locations(id) ON DELETE CASCADE, destination_location_id INTEGER NOT NULL REFERENCES locations(id) ON DELETE CASCADE, departure_time TEXT NOT NULL, return_time TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_routes_shift_id ON route