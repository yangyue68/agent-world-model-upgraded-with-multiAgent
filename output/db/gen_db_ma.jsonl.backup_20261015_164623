)), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_tickets_ticket_type_id ON tickets(ticket_type_id);", "CREATE INDEX idx_tickets_status ON tickets(status);", "CREATE INDEX idx_tickets_checked_in_at ON tickets(checked_in_at);"]}]}, "db_path": "output/db/databases/FestivalOps_task_1.db"}
{"scenario": "FestivalOps", "task_id": "task_2", "task": "Filter vendor records for 'Electric Bay 2025' to show only food and merchandise vendors with permit status Pending or Expired, and return vendor name, booth number, permit number, fee amount, amount paid, and assigned zone.", "db_schema": {"tables": [{"name": "festivals", "ddl": "CREATE TABLE festivals (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT NOT NULL UNIQUE,\n  start_date DATE,\n  end_date DATE,\n  location TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);", "indexes": ["CREATE INDEX idx_festivals_name ON festivals(name);"]}, {"name": "zones", "ddl": "CREATE TABLE zones (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  festival_id INTEGER NOT NULL,\n  name TEXT NOT NULL,\n  description TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (festival_id) REFERENCES festivals(id) ON DELETE CASCADE,\n  UNIQUE (festival_id, name)\n);", "indexes": ["CREATE INDEX idx_zones_festival_id ON zones(festival_id);", "CREATE INDEX idx_zones_name ON zones(name);"]}, {"name": "vendors", "ddl": "CREATE TABLE vendors (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  festival_id INTEGER NOT NULL,\n  name TEXT NOT NULL,\n  vendor_type TEXT NOT NULL CHECK (vendor_type IN ('Food', 'Merchandise', 'Service', 'Other')),\n  contact_name TEXT,\n  contact_email TEXT,\n  contact_phone TEXT,\n  created_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  updated_at DATETIME DEFAULT CURRENT_TIMESTAMP,\n  FOREIGN KEY (festival_id) REFERENCES festivals(id) ON DELETE CASCADE\n);", "indexes": ["CREATE INDEX idx_vendors_festival_id ON vendors(festival_id);", "CREATE INDEX idx_vendors_name ON vendors(name);", "CREATE INDEX idx_vendors_vendor_type ON vendors(vendor_type);"]}, {"name": "permits", "ddl": "CREATE TABLE permits (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  vendor_id INTEGER NOT NULL,\n  permit_number TEXT NOT NULL