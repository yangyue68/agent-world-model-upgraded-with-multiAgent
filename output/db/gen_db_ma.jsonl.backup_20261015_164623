{"scenario": "Wild Apricot", "task_id": "task_6", "task": "Add two custom fields to the membership application form: 'Professional Certification' (optional text field) and 'Years of Experience' (required number field, minimum 0). Then create a new membership level 'Senior Professional' that requires 'Years of Experience' to be at least 5, has an annual fee of $250, duration of 1 year, automatic renewal every year, and set up a renewal reminder email to be sent 60 days before expiration for this level.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT UNIQUE NOT NULL, email TEXT UNIQUE, first_name TEXT, last_name TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "custom_fields", "ddl": "CREATE TABLE custom_fields (id INTEGER PRIMARY KEY, field_name TEXT NOT NULL, field_type TEXT NOT NULL CHECK (field_type IN ('text', 'number', 'date', 'boolean', 'select')), is_required INTEGER NOT NULL DEFAULT 0 CHECK (is_required IN (0, 1)), min_value REAL, max_value REAL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_custom_fields_field_name ON custom_fields(field_name);"]}, {"name": "membership_levels", "ddl": "CREATE TABLE membership_levels (id INTEGER PRIMARY KEY, level_name TEXT NOT NULL UNIQUE, annual_fee REAL NOT NULL CHECK (annual_fee >= 0), duration_months INTEGER NOT NULL CHECK (duration_months > 0), auto_renew INTEGER NOT NULL DEFAULT 0 CHECK (auto_renew IN (0, 1)), renewal_reminder_days INTEGER CHECK (renewal_reminder_days >= 0), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_membership_levels_level_name ON membership_levels(level_name);"]}, {"name": "membership_level_custom_fields", "ddl": "CREATE TABLE membership_level_custom_fields (id INTEGER PRIMARY KEY, membership_level_id INTEGER NOT NULL, custom_field_id INTEGER NOT NULL, min_value REAL, max_value REAL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (membership_level_id) REFERENCES membership_levels(id) ON DELETE CASCADE, FOREIGN KEY (custom_field_id) REFERENCES custom_fields(id) ON DELETE CASCADE, UNIQUE (membership_level_id, custom_field_id));", "indexes": ["CREATE INDEX idx_mlcf_membership_level_id ON membership_level_custom_fields(membership_level_id);", "CREATE INDEX idx_mlcf_custom_field_id ON membership_level_custom_fields(custom_field_id);"]}, {"name": "renewal_reminder_emails", "ddl": "CREATE TABLE renewal_reminder_emails (id INTEGER PRIMARY KEY, membership_level_id INTEGER NOT NULL, days_before_expiration INTEGER NOT NULL CHECK (days_before_expiration >= 0), email_subject TEXT NOT NULL, email_body TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (membership_level_id) REFERENCES membership_levels(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_rre_membership_level_id ON renewal_reminder_emails(membership_level_id);"]}]}, "db_path": "output/db/databases/Wild-Apricot_task_6.db"}
{"scenario": "Wild Apricot", "task_id": "task_7", "task": "Approve pending membership application APP-2389 for Priya Nair (priya.nair@example.com) at the 'Young Professional' level with a start date of August 1, 2025 and annual dues of $85; generate the initial invoice and send the application approval email. Also reject pending application APP-2395 from Daniel Ortiz for the 'Corporate' level with the reason 'Incomplete business documentation' and send the rejection notification.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY AUTOINCREMENT, first_name TEXT NOT NULL, last_name TEXT NOT NULL, email TEXT UNIQUE NOT NULL, phone TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_email ON users(email);", "CREATE INDEX idx_users_name ON users(last_name, first_name);"]}, {"name": "membership_levels", "ddl": "CREATE TABLE membership_levels (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT UNIQUE NOT NULL, description TEXT, annual_dues REAL NOT NULL CHECK (annual_dues >= 0), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_membership_levels_name ON membership_levels(name);"]}, {"name": "memberships", "ddl": "CREATE TABLE memberships (id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, level_id INTEGER NOT NULL REFERENCES membership_levels(id) ON DELETE RESTRICT, start_date DATE NOT NULL, end_date DATE, status TEXT NOT NULL CHECK (status IN ('active', 'expired', 'cancelled', 'pending')) DEFAULT 'active', created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_memberships_user_id ON memberships(user_id);", "CREATE INDEX idx_memberships_level_id ON memberships(level_id);", "CREATE INDEX idx_memberships_status ON memberships(status);", "CREATE INDEX idx_memberships_dates ON memberships(start_date, end_date);"]}, {"name": "applications", "ddl": "CREATE TABLE applications (id INTEGER PRIMARY KEY AUTOINCREMENT, application_number TEXT UNIQUE NOT NULL, applicant_user_id INTEGER REFERENCES users(id) ON DELETE SET NULL, applicant_first_name TEXT NOT NULL, applicant_last_name TEXT NOT NULL, applicant_email TEXT NOT NULL, level_id INTEGER NOT NULL REFERENCES membership_levels(id) ON DELETE RESTRICT, status TEXT NOT NULL CHECK (status IN ('pending', 'approved', 'rejected')) DEFAULT 'pending', submitted_at DATETIME DEFAULT CURRENT_TIMESTAMP, reviewed_at DATETIME, reviewed_by_user_id INTEGER REFERENCES users(id) ON DELETE SET NULL, rejection_reason TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_applications_application_number ON applications(application_number);", "CREATE INDEX idx_applications_status ON applications(status);", "CREATE INDEX idx_applications_applicant_email ON applications(applicant_email);", "CREATE INDEX idx_applications_level_id ON applications(level_id);", "CREATE INDEX idx_applications_reviewed_by ON applications(reviewed_by_user_id);"]}, {"name": "invoices", "ddl": "CREATE TABLE invoices (id INTEGER PRIMARY KEY AUTOINCREMENT, invoice_number TEXT UNIQUE NOT NULL, user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE, membership_id INTEGER REFERENCES memberships(id) ON DELETE SET NULL, application_id INTEGER REFERENCES applications(id) ON DELETE SET NULL, amount REAL NOT NULL CHECK (amount >= 0), issue_date DATE NOT NULL, due_date DATE NOT NULL, status TEXT NOT NULL CHECK (status IN ('draft', 'sent', 'paid', 'overdue', 'cancelled')) DEFAULT 'draft', created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_invoices_invoice_number ON invoices(invoice_number);", "CREATE INDEX idx_invoices_user_id ON invoices(user_id);", "CREATE INDEX idx_invoices_membership_id ON invoices(membership_id);", "CREATE INDEX idx_invoices_application_id ON invoices(application_id);", "CREATE INDEX idx_invoices_status ON invoices(status);", "CREATE INDEX idx_invoices_due_date ON invoices(due_date);"]}, {"name": "email_log", "ddl": "CREATE TABLE email_log (id INTEGER PRIMARY KEY AUTOINCREMENT, recipient_email TEXT NOT NULL, subject TEXT NOT NULL, body TEXT, sent_at DATETIME DEFAULT CURRENT_TIMESTAMP, status TEXT NOT NULL CHECK (status IN ('sent', 'failed', 'queued')) DEFAULT 'sent', related_application_id INTEGER REFERENCES applications(id) ON DELETE SET NULL, related_invoice_id INTEGER REFERENCES invoices(id) ON DELETE SET NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_email_log_recipient_email ON email_log(recipient_email);", "CREATE INDEX idx_email_log_related_application ON email_log(related_application_id);", "CREATE INDEX idx_email_log_related_invoice ON email_log(related_invoice_id);", "CREATE INDEX idx_email_log_sent_at ON email_log(sent_at);"]}]}, "db_path": "output/db/databases/Wild-Apricot_task_7.db"}
{"scenario": "Wild Apricot", "task_id": "task_8", "task": "Renew Maria Chen's (member ID 10482) expired 'Standard' membership by 12 months, changing her level to 'Premium' effective July 1, 2025, set the new expiration date to June 30, 2026, record an offline payment of $150 by check #4521, and send a renewal confirmation email.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY, first_name TEXT NOT NULL, last_name TEXT NOT NULL, email TEXT UNIQUE NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_email ON users(email);", "CREATE INDEX idx_users_last_name ON users(last_name);"]}, {"name": "membership_levels", "ddl": "CREATE TABLE membership_levels (id INTEGER PRIMARY KEY, name TEXT UNIQUE NOT NULL, description TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_membership_levels_name ON membership_levels(name);"]}, {"name": "members", "ddl": "CREATE TABLE members (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id), membership_level_id INTEGER NOT NULL REFERENCES membership_levels(id), status TEXT NOT NULL CHECK (status IN ('active', 'expired', 'pending', 'cancelled')), join_date DATE NOT NULL, expiration_date DATE, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_members_user_id ON members(user_id);", "CREATE INDEX idx_members_membership_level_id ON members(membership_level_id);", "CREATE INDEX idx_members_status ON members(status);", "CREATE INDEX idx_members_expiration_date ON members(expiration_date);"]}, {"name": "membership_renewals", "ddl": "CREATE TABLE membership_renewals (id INTEGER PRIMARY KEY, member_id INTEGER NOT NULL REFERENCES members(id), previous_level_id INTEGER REFERENCES membership_levels(id), new_level_id INTEGER NOT NULL REFERENCES membership_levels(id), previous_expiration_date DATE, new_expiration_date DATE NOT NULL, renewal_date DATE NOT NULL, duration_months INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_membership_renewals_member_id ON membership_renewals(member_id);", "CREATE INDEX idx_membership_renewals_new_level_id ON membership_renewals(new_level_id);", "CREATE INDEX idx_membership_renewals_renewal_date ON membership_renewals(renewal_date);"]}, {"name": "payments", "ddl": "CREATE TABLE payments (id INTEGER PRIMARY KEY, member_id INTEGER NOT NULL REFERENCES members(id), renewal_id INTEGER REFERENCES membership_renewals(id), amount REAL NOT NULL CHECK (amount > 0), payment_date DATE NOT NULL, payment_method TEXT NOT NULL CHECK (payment_method IN ('cash', 'check', 'credit_card', 'bank_transfer', 'other')), reference_number TEXT, notes TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_payments_member_id ON payments(member_id);", "CREATE INDEX idx_payments_renewal_id ON payments(renewal_id);", "CREATE INDEX idx_payments_payment_date ON payments(payment_date);", "CREATE INDEX idx_payments_reference_number ON payments(reference_number);"]}, {"name": "email_log", "ddl": "CREATE TABLE email_log (id INTEGER PRIMARY KEY, member_id INTEGER NOT NULL REFERENCES members(id), renewal_id INTEGER REFERENCES membership_renewals(id), recipient_email TEXT NOT NULL, subject TEXT NOT NULL, body TEXT, sent_at DATETIME DEFAULT CURRENT_TIMESTAMP, status TEXT NOT NULL CHECK (status IN ('sent', 'failed', 'pending')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_email_log_member_id ON email_log(member_id);", "CREATE INDEX idx_email_log_renewal_id ON email_log(renewal_id);", "CREATE INDEX idx_email_log_sent_at ON email_log(sent_at);"]}, {"name": "audit_log", "ddl": "CREATE TABLE audit_log (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id), action TEXT NOT NULL, entity_type TEXT NOT NULL, entity_id INTEGER NOT NULL, details TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_audit_log_user_id ON audit_log(user_id);", "CREATE INDEX idx_audit_log_entity ON audit_log(entity_type, entity_id);", "CREATE INDEX idx_audit_log_created_at ON audit_log(created_at);"]}]}, "db_path": "output/db/databases/Wild-Apricot_task_8.db"}
{"scenario": "Wild Apricot", "task_id": "task_9", "task": "Suspend Robert Johnson's (robert.johnson@example.com, member ID 3310) membership effective immediately for non-payment of $75 dues, then after recording the outstanding payment, reinstate his membership and update his level from 'Basic' to 'Plus' with an expiration date of December 31, 2025; add an internal note 'Suspended for non-payment; reinstated after payment received.'", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT UNIQUE NOT NULL, email TEXT UNIQUE NOT NULL, first_name TEXT, last_name TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "members", "ddl": "CREATE TABLE members (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL REFERENCES users(id), member_number TEXT UNIQUE NOT NULL, status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'suspended', 'expired', 'cancelled')), level TEXT NOT NULL DEFAULT 'Basic', expiration_date DATE, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_members_user_id ON members(user_id);", "CREATE INDEX idx_members_member_number ON members(member_number);", "CREATE INDEX idx_members_status ON members(status);"]}, {"name": "dues", "ddl": "CREATE TABLE dues (id INTEGER PRIMARY KEY, member_id INTEGER NOT NULL REFERENCES members(id), amount REAL NOT NULL, due_date DATE NOT NULL, paid_date DATE, status TEXT NOT NULL DEFAULT 'unpaid' CHECK (status IN ('unpaid', 'paid', 'waived')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_dues_member_id ON dues(member_id);", "CREATE INDEX idx_dues_status ON dues(status);"]}, {"name": "member_notes", "ddl": "CREATE TABLE member_notes (id I