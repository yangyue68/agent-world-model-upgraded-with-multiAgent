{"scenario": "Eventbrite", "task_id": "task_8", "task": "Create a donation ticket type named 'Pay What You Can' for the event 'Charity Gala 2025' with a minimum donation of $10, no maximum, a quantity of 200, sale window from May 1 to May 30, 2025, and enable a waitlist if the ticket sells out. Also, set an order limit of 1 ticket per order. Then create an add-on ticket type 'VIP Reception' priced at $25 with a quantity of 50, available only to attendees who have purchased the donation ticket.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT UNIQUE NOT NULL, email TEXT UNIQUE NOT NULL, full_name TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "events", "ddl": "CREATE TABLE events (id INTEGER PRIMARY KEY, organizer_id INTEGER NOT NULL, title TEXT NOT NULL, description TEXT, start_time DATETIME NOT NULL, end_time DATETIME, venue TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (organizer_id) REFERENCES users(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_events_organizer_id ON events(organizer_id);", "CREATE INDEX idx_events_title ON events(title);"]}, {"name": "ticket_types", "ddl": "CREATE TABLE ticket_types (id INTEGER PRIMARY KEY, event_id INTEGER NOT NULL, name TEXT NOT NULL, type TEXT NOT NULL CHECK (type IN ('donation', 'addon', 'standard')), price REAL, min_donation REAL, max_donation REAL, quantity INTEGER NOT NULL CHECK (quantity >= 0), sale_start DATETIME, sale_end DATETIME, waitlist_enabled INTEGER NOT NULL DEFAULT 0 CHECK (waitlist_enabled IN (0, 1)), order_limit INTEGER CHECK (order_limit > 0), parent_ticket_type_id INTEGER, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (event_id) REFE