{"scenario": "Eventbrite", "task_id": "task_10", "task": "For Eventbrite event 'Spring Charity Gala' (event ID 987654321), issue a full refund for order ID 555666777 totaling $250.00, transfer ticket ID TKT-222333 from jane.doe@example.com to new.attendee@example.com, and create a complimentary ticket for 'Michael Chen' at michael.chen@example.com with the note 'VIP guest'.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT UNIQUE NOT NULL, full_name TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_email ON users(email);"]}, {"name": "events", "ddl": "CREATE TABLE events (id INTEGER PRIMARY KEY, name TEXT NOT NULL, description TEXT, start_time DATETIME, end_time DATETIME, venue TEXT, organizer_id INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (organizer_id) REFERENCES users(id));", "indexes": ["CREATE INDEX idx_events_organizer_id ON events(organizer_id);", "CREATE INDEX idx_events_name ON events(name);"]}, {"name": "orders", "ddl": "CREATE TABLE orders (id INTEGER PRIMARY KEY, event_id INTEGER NOT NULL, buyer_id INTEGER NOT NULL, total_amount REAL NOT NULL CHECK (total_amount >= 0), status TEXT NOT NULL DEFAULT 'pending' CHECK (status IN ('pending', 'completed', 'refunded', 'cancelled')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (event_id) REFERENCES events(id), FOREIGN KEY (buyer_id) REFERENCES users(id));", "indexes": ["CREATE INDEX idx_orders_event_id ON orders(event_id);", "CREATE INDEX idx_orders_buyer_id ON orders(buyer_id);", "CREATE INDEX idx_orders_status ON orders(status);"]}, {"name": "refunds", "ddl": "CREATE TABLE refunds (id INTEGER PRIMARY KEY, order_id INTEGER NOT NULL, amount REAL NOT NULL CHECK (amount > 0), reason TEXT, refunded_by INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (order_id) REFERENCES orders(id), FOREIGN KEY (refunded_by) REFERENCES users(id));", "indexes": ["CREATE INDEX idx_refunds_order_id ON refunds(order_id);", "CREATE INDEX idx_refunds_refunded_by ON refunds(refunded_by);"]}, {"name": "tickets", "ddl": "CREATE TABLE tickets (id TEXT PRIMARY KEY, order_id INTEGER, event_id INTEGER NOT NULL, attendee_id INTEGER, ticket_type TEXT NOT NULL DEFAULT 'general', price REAL NOT NULL DEFAULT 0 CHECK (price >= 0), status TEXT NOT NULL DEFAULT 'valid' CHECK (status IN ('valid', 'used', 'cancelled', 'transferred')), note TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (order_id) REFERENCES orders(id), FOREIGN KEY (event_id) REFERENCES events(id), FOREIGN KEY (attendee_id) REFERENCES users(id));", "indexes": ["CREATE INDEX idx_tickets_order_id ON tickets(order_id);", "CREATE INDEX idx_tickets_event_id ON tickets(event_id);", "CREATE INDEX idx_tickets_attendee_id ON tickets(attendee_id);", "CREATE INDEX idx_tickets_status ON tickets(status);"]}, {"name": "ticket_transfers", "ddl": "CREATE TABLE ticket_transfers (id INTEGER PRIMARY KEY, ticket_id TEXT NOT NULL, from_user_id INTEGER NOT NULL, to_user_id INTEGER NOT NULL, transferred_by INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (ticket_id) REFERENCES tickets(id), FOREIGN KEY (from_user_id) REFERENCES users(id), FOREIGN KEY (to_user_id) REFERENCES users(id), FOREIGN KEY (transferred_by) REFERENCES users(id));", "indexes": ["CREATE INDEX idx_ticket_transfers_ticket_id ON ticket_transfers(ticket_id);", "CREATE INDEX idx_ticket_transfers_from_user_id ON ticket_transfers(from_user_id);", "CREATE INDEX idx_ticket_transfers_to_user_id ON ticket_transfers(to_user_id);", "CREATE INDEX idx_ticket_transfers_transferred_by ON ticket_transfers(transferred_by);"]}]}, "db_path": "output/db/databases/Eventbrite_task_10.db"}
{"scenario": "Expedia", "task_id": "task_1", "task": "Search for round-trip flights from Seattle to Tokyo between June 15 and June 22, 2024, and compare the top 3 options by total price, layover duration, and airline rating.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT UNIQUE NOT NULL, email TEXT UNIQUE NOT NULL, first_name TEXT, last_name TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "airlines", "ddl": "CREATE TABLE airlines (id INTEGER PRIMARY KEY, name TEXT NOT NULL, iata_code TEXT UNIQUE NOT NULL, rating REAL CHECK (rating >= 0 AND rating <= 5), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_airlines_iata_code ON airlines(iata_code);", "CREATE INDEX idx_airlines_rating ON airlines(rating);"]}, {"name": "airports", "ddl": "CREATE TABLE airports (id INTEGER PRIMARY KEY, name TEXT NOT NULL, iata_code TEXT UNIQUE NOT NULL, city TEXT NOT NULL, country TEXT NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_airports_iata_code ON airports(iata_code);", "CREATE INDEX idx_airports_city ON airports(city);", "CREATE INDEX idx_airports_country ON airports(country);"]}, {"name": "flights", "ddl": "CREATE TABLE flights (id INTEGER PRIMARY KEY, airline_id INTEGER NOT NULL, flight_number TEXT NOT NULL, origin_airport_id INTEGER NOT NULL, destination_airport_id INTEGER NOT NULL, departure_datetime DATETIME NOT NULL, arrival_datetime DATETIME NOT NULL, duration_minutes INTEGER NOT NULL CHECK (duration_minutes > 0), base_price REAL NOT NULL CHECK (base_price >= 0), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (airline_id) REFERENCES airlines(id), FOREIGN KEY (origin_airport_id) REFERENCES airports(id), FOREIGN KEY (destination_airport_id) REFERENCES airports(id));", "indexes": ["CREATE INDEX idx_flights_airline_id ON flights(airline_id);", "CREATE INDEX idx_flights_origin_airport_id ON flights(origin_airport_id);", "CREATE INDEX idx_flights_destination_airport_id ON flights(destination_airport_id);", "CREATE INDEX idx_flights_departure_datetime ON flights(departure_datetime);", "CREATE INDEX idx_flights_arrival_datetime ON flights(arrival_datetime);", "CREATE INDEX idx_flights_route ON flights(origin_airport_id, destination_airport_id);"]}, {"name": "flight_prices", "ddl": "CREATE TABLE flight_prices (id INTEGER PRIMARY KEY, flight_id INTEGER NOT NULL, cabin_class TEXT NOT NULL CHECK (cabin_class IN ('economy', 'premium_economy', 'business', 'first')), price REAL NOT NULL CHECK (price >= 0), currency TEXT NOT NULL DEFAULT 'USD', valid_from DATETIME NOT NULL, valid_to DATETIME NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (flight_id) REFERENCES flights(id));", "indexes": ["CREATE INDEX idx_flight_prices_flight_id ON flight_prices(flight_id);", "CREATE INDEX idx_flight_prices_cabin_class ON flight_prices(cabin_class);", "CREATE INDEX idx_flight_prices_validity ON flight_prices(valid_from, valid_to);"]}, {"name": "flight_layovers", "ddl": "CREATE TABLE flight_layovers (id INTEGER PRIMARY KEY, flight_id INTEGER NOT NULL, airport_id INTEGER NOT NULL, layover_duration_minutes INTEGER NOT NULL CHECK (layover_duration_minutes > 0), sequence INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (flight_id) REFERENCES flights(id), FOREIGN KEY (airport_id) REFERENCES airports(id), UNIQUE (flight_id, sequence));", "indexes": ["CREATE INDEX idx_flight_layovers_flight_id ON flight_layovers(flight_id);", "CREATE INDEX idx_flight_layovers_airport_id ON