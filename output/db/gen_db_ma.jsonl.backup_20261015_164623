ason TEXT NOT NULL, resolved_by_user_id INTEGER NOT NULL, resolved_at DATETIME DEFAULT CURRENT_TIMESTAMP, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (equipment_id) REFERENCES equipment(id), FOREIGN KEY (winning_booking_id) REFERENCES bookings(id), FOREIGN KEY (displaced_booking_id) REFERENCES bookings(id), FOREIGN KEY (resolved_by_user_id) REFERENCES users(id));", "indexes": ["CREATE INDEX idx_conflict_resolutions_equipment_id ON conflict_resolutions(equipment_id);", "CREATE INDEX idx_conflict_resolutions_winning_booking_id ON conflict_resolutions(winning_booking_id);", "CREATE INDEX idx_conflict_resolutions_displaced_booking_id ON conflict_resolutions(displaced_booking_id);"]}, {"name": "alternate_date_options", "ddl": "CREATE TABLE alternate_date_options (id INTEGER PRIMARY KEY, conflict_resolution_id INTEGER NOT NULL, proposed_start_datetime DATETIME NOT NULL, proposed_end_datetime DATETIME NOT NULL, is_selected INTEGER NOT NULL DEFAULT 0 CHECK (is_selected IN (0,1)), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (conflict_resolution_id) REFERENCES conflict_resolutions(id), CHECK (proposed_end_datetime > proposed_start_datetime));", "indexes": ["CREATE INDEX idx_alternate_date_options_conflict_resolution_id ON alternate_date_options(conflict_resolution_id);"]}]}, "db_path": "output/db/databases/LoopSpace_task_10.db"}
