{"scenario": "PipeForge", "task_id": "task_1", "task": "In PipeForge, create a pipeline named daily_sales_etl in the dev environment with four tasks: extract_sales using Postgres connection prod_sales_db to run SELECT * FROM sales WHERE sale_date = CURRENT_DATE - 1, transform_sales as a Python task that cleans and aggregates daily sales, load_sales using Snowflake connection sales_warehouse to append to analytics.daily_sales, and notify_slack using Slack connection data_alerts to post a success message. Set dependencies extract_sales -> transform_sales -> load_sales -> notify_slack, schedule the pipeline daily at 03:00 UTC, and configure each task to retry up to 2 times with a 5-minute delay between attempts.", "db_schema": {"tables": [{"name": "users", "ddl": "CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT UNIQUE NOT NULL, display_name TEXT, email TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_users_username ON users(username);", "CREATE INDEX idx_users_email ON users(email);"]}, {"name": "environments", "ddl": "CREATE TABLE environments (id INTEGER PRIMARY KEY, name TEXT UNIQUE NOT NULL, description TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP);", "indexes": ["CREATE INDEX idx_environments_name ON environments(name);"]}, {"name": "connections", "ddl": "CREATE TABLE connections (id INTEGER PRIMARY KEY, name TEXT NOT NULL, connection_type TEXT NOT NULL CHECK (connection_type IN ('postgres','snowflake','slack','mysql','bigquery','redshift','python')), environment_id INTEGER NOT NULL REFERENCES environments(id) ON DELETE CASCADE, config_json TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(name, environment_id));", "indexes": ["CREATE INDEX idx_connections_environment_id ON connections(environment_id);", "CREATE INDEX idx_connections_type ON connections(connection_type);"]}, {"name": "pipelines", "ddl": "CREATE TABLE pipelines (id INTEGER PRIMARY KEY, name TEXT NOT NULL, environment_id INTEGER NOT NULL REFERENCES environments(id) ON DELETE CASCADE, description TEXT, schedule_cron TEXT, schedule_timezone TEXT DEFAULT 'UTC', is_active INTEGER NOT NULL DEFAULT 1 CHECK (is_active IN (0,1)), created_by INTEGER REFERENCES users(id), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(name, environment_id));", "indexes": ["CREATE INDEX idx_pipelines_environment_id ON pipelines(environment_id);", "CREATE INDEX idx_pipelines_name ON pipelines(name);", "CREATE INDEX idx_pipelines_created_by ON pipelines(created_by);"]}, {"name": "tasks", "ddl": "CREATE TABLE tasks (id INTEGER PRIMARY KEY, pipeline_id INTEGER NOT NULL REFERENCES pipelines(id) ON DELETE CASCADE, name TEXT NOT NULL, task_type TEXT NOT NULL CHECK (task_type IN ('sql','python','load','notify','bash','http')), connection_id INTEGER REFERENCES connections(id) ON DELETE SET NULL, sql_query TEXT, python_code TEXT, notify_config_json TEXT, retry_count INTEGER NOT NULL DEFAULT 0 CHECK (retry_count >= 0), retry_delay_seconds INTEGER NOT NULL DEFAULT 0 CHECK (retry_delay_seconds >= 0), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(pipeline_id, name));", "indexes": ["CREATE INDEX idx_tasks_pipeline_id ON tasks(pipeline_id);", "CREATE INDEX idx_tasks_connection_id ON tasks(connection_id);", "CREATE INDEX idx_tasks_type ON tasks(task_type);"]}, {"name": "task_dependencies", "ddl": "CREATE TABLE task_dependencies (id INTEGER PRIMARY KEY, task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE, depends_on_task_id INTEGER NOT NULL REFERENCES tasks(id) ON DELETE CASCADE, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, UNIQUE(task_id, depends_on_task_id), CHECK (task_id != depends_on_task_id));", "indexes": ["CREATE INDEX idx_task_dependencies_task_id ON task_dependencies(task_id);", "CREATE INDEX idx_task_dependencies_depends_on ON task_dependencies(depends_on_task_id);"]}]}, "db_path": "output/db/databases/PipeForge_task_1.db"}
