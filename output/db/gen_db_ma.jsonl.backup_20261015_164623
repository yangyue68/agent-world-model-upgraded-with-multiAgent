iews_company_location_id ON reviews(company_location_id);", "CREATE INDEX idx_reviews_job_title_id ON reviews(job_title_id);", "CREATE INDEX idx_reviews_review_date ON reviews(review_date);", "CREATE INDEX idx_reviews_company_job_date ON reviews(company_location_id, job_title_id, review_date DESC);"]}]}, "db_path": "output/db/databases/Indeed_task_9.db"}
