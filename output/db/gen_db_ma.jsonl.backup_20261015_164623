_profile_id ON sitter_services(sitter_profile_id);", "CREATE INDEX idx_sitter_services_service_type ON sitter_services(service_type);"]}, {"name": "sitter_pet_types", "ddl": "CREATE TABLE sitter_pet_types (id INTEGER PRIMARY KEY, sitter_profile_id INTEGER NOT NULL, pet_type TEXT NOT NULL CHECK(pet_type IN ('dog','cat','bird','fish','reptile','small_mammal','other')), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (sitter_profile_id) REFERENCES sitter_profiles(id) ON DELETE CASCADE, UNIQUE(sitter_profile_id, pet_type));", "indexes": ["CREATE INDEX idx_sitter_pet_types_sitter_profile_id ON sitter_pet_types(sitter_profile_id);", "CREATE INDEX idx_sitter_pet_types_pet_type ON sitter_pet_types(pet_type);"]}, {"name": "sitter_availability", "ddl": "CREATE TABLE sitter_availability (id INTEGER PRIMARY KEY, sitter_profile_id INTEGER NOT NULL, available_date TEXT NOT NULL, is_available INTEGER NOT NULL DEFAULT 1 CHECK(is_available IN (0,1)), created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (sitter_profile_id) REFERENCES sitter_profiles(id) ON DELETE CASCADE, UNIQUE(sitter_profile_id, available_date));", "indexes": ["CREATE INDEX idx_sitter_availability_sitter_profile_id ON sitter_availability(sitter_profile_id);", "CREATE INDEX idx_sitter_availability_date ON sitter_availability(available_date);", "CREATE INDEX idx_sitter_availability_profile_date ON sitter_availability(sitter_profile_id, available_date);"]}, {"name": "sitter_verifications", "ddl": "CREATE TABLE sitter_verifications (id INTEGER PRIMARY KEY, sitter_profile_id INTEGER NOT NULL, verification_type TEXT NOT NULL CHECK(verification_type IN ('identity','background_check','email','phone','address','pet_first_aid','insurance')), status TEXT NOT NULL DEFAULT 'pending' CHECK(status IN ('pending','verified','rejected','expired')), verified_at DATETIME, expires_at DATETIME, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (sitter_profile_id) REFERENCES sitter_profiles(id) ON DELETE CASCADE, UNIQUE(sitter_profile_id, verification_type));", "indexes": ["CREATE INDEX idx_sitter_verifications_sitter_profile_id ON sitter_verifications(sitter_profile_id);", "CREATE INDEX idx_sitter_verifications_type_status ON sitter_verifications(verification_type, status);"]}, {"name": "reviews", "ddl": "CREATE TABLE reviews (id INTEGER PRIMARY KEY, sitter_profile_id INTEGER NOT NULL, reviewer_id INTEGER NOT NULL, booking_id INTEGER, rating INTEGER NOT NULL CHECK(rating BETWEEN 1 AND 5), comment TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (sitter_profile_id) REFERENCES sitter_profiles(id) ON DELETE CASCADE, FOREIGN KEY (reviewer_id) REFERENCES users(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_reviews_sitter_profile_id ON reviews(sitter_profile_id);", "CREATE INDEX idx_reviews_reviewer_id ON reviews(reviewer_id);", "CREATE INDEX idx_reviews_rating ON reviews(rating);"]}, {"name": "bookings", "ddl": "CREATE TABLE bookings (id INTEGER PRIMARY KEY, owner_id INTEGER NOT NULL, sitter_profile_id INTEGER NOT NULL, service_type TEXT NOT NULL CHECK(service_type IN ('house_sitting','drop_in_visits','boarding','dog_walking')), start_date TEXT NOT NULL, end_date TEXT NOT NULL, nightly_rate REAL, total_estimated_cost REAL, status TEXT NOT NULL DEFAULT 'inquiry' CHECK(status IN ('inquiry','pending','confirmed','cancelled','completed')), message TEXT, max_budget_per_night REAL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (owner_id) REFERENCES users(id) ON DELETE CASCADE, FOREIGN KEY (sitter_profile_id) REFERENCES sitter_profiles(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_bookings_owner_id ON bookings(owner_id);", "CREATE INDEX idx_bookings_sitter_profile_id ON bookings(sitter_profile_id);", "CREATE INDEX idx_bookings_status ON bookings(status);", "CREATE INDEX idx_bookings_dates ON bookings(start_date, end_date);"]}, {"name": "booking_pets", "ddl": "CREATE TABLE booking_pets (id INTEGER PRIMARY KEY, booking_id INTEGER NOT NULL, pet_id INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (booking_id) REFERENCES bookings(id) ON DELETE CASCADE, FOREIGN KEY (pet_id) REFERENCES pets(id) ON DELETE CASCADE, UNIQUE(booking_id, pet_id));", "indexes": ["CREATE INDEX idx_booking_pets_booking_id ON booking_pets(booking_id);", "CREATE INDEX idx_booking_pets_pet_id ON booking_pets(pet_id);"]}]}, "db_path": "output/db/databases/Pawshake_task_15.db"}
