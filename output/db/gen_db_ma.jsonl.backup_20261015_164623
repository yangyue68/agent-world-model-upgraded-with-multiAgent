e_id, display_order);"]}, {"name": "section_fields", "ddl": "CREATE TABLE section_fields (id INTEGER PRIMARY KEY AUTOINCREMENT, section_id INTEGER NOT NULL, field_type TEXT NOT NULL CHECK (field_type IN ('photo', 'yes_no_dropdown', 'numeric_input', 'dropdown', 'digital_signature')), label TEXT NOT NULL, is_mandatory INTEGER NOT NULL DEFAULT 0 CHECK (is_mandatory IN (0, 1)), display_order INTEGER NOT NULL DEFAULT 0, options TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, updated_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (section_id) REFERENCES template_sections(id) ON DELETE CASCADE);", "indexes": ["CREATE INDEX idx_section_fields_section_id ON section_fields(section_id);", "CREATE INDEX idx_section_fields_display_order ON section_fields(section_id, display_order);"]}, {"name": "template_attachments", "ddl": "CREATE TABLE template_attachments (id INTEGER PRIMARY KEY AUTOINCREMENT, template_id INTEGER NOT NULL, file_name TEXT NOT NULL, file_path TEXT NOT NULL, file_type TEXT, file_size INTEGER, uploaded_by INTEGER NOT NULL, created_at DATETIME DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY (template_id) REFERENCES workflow_templates(id) ON DELETE CASCADE, FOREIGN KEY (uploaded_by) REFERENCES users(id) ON DELETE RESTRICT);", "indexes": ["CREATE INDEX idx_template_attachments_template_id ON template_attachments(template_id);", "CREATE INDEX idx_template_attachments_uploaded_by ON template_attachments(uploaded_by);"]}]}, "db_path": "output/db/databases/NexusFlow_task_1.db"}
